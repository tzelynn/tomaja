{
  "name": "tomaja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "content": "tsx scripts/validate-content.ts && tsx scripts/build-content.ts",
    "build": "tsx scripts/validate-content.ts && tsx scripts/build-content.ts && tsx scripts/build-strokes.ts && tsx scripts/subset-font.ts && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "audio:generate": "tsx scripts/generate-audio.ts",
    "audio:review": "tsx scripts/review-audio.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler d1 migrations apply tomaja --remote && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "hono": "^4.13.18",
    "idb": "^8.0.4",
    "ts-fsrs": "^6.0.0"
  }
}
